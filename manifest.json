{
	"manifest_version": 3,
	"name": "SuperGenPass Classic",
	"version": "0.1.0",
	"description": "Classic SuperGenPass-compatible local password generator.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"64": "icons/icon-64.png",
		"96": "icons/icon-96.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png"
		},
		"default_title": "SuperGenPass",
		"default_popup": "popup/popup.html"
	},
	"permissions": [
		"tabs",
		"clipboardWrite"
	],
	"content_scripts": [
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"src/content.js"
			],
			"run_at": "document_idle"
		}
	],

	"browser_specific_settings": {
		"gecko": {
			"id": "Scottchiefbaker@SuperGenPass",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			},
			"strict_min_version": "58.0"
		}
	}
}
